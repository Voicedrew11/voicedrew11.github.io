    <img class="book" src="covers/orthodoxy.jpg" alt="Orthodoxy">
    <img class="book" src="covers/tgf.jpg" alt="The Great Fiction">
    <img class="book" src="covers/screwtape.png" alt="The Screwtape Letters">
    <img class="book" src="covers/confessions.jpeg" alt="The Confessions">
    <img class="book" src="covers/ruleofsaintbenedict.jpg.jpeg" alt="The Rule of Saint Benedict">
