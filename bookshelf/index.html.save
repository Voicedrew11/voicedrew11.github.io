<style>
  body {
    background-image: url("https://sadhost.neocities.org/images/tiles/misc341.jpg");
  }

  .book {
    width: 180px;
    height: 270px;
    background-color: #ffcc66;
    border: 1px solid var(--li);
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
    margin: 0px;
  }
</style>


<body>
  <div id="content">
    <h1>Voicedrew's Bookshelf</h1>
    <h2>Literature</h2>
    <img class="book" src="covers/liborequ.jpg" alt="Liberty or Equality">
